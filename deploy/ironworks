def check_pins(rep):
    ic, why = pin_file("IRONCLAW_PIN")
    if ic:
        rep.ok("pin.ironclaw", CONFIG, f"IRONCLAW_PIN = {ic[:9]}")
        rep.data["ironclaw_pin"] = ic
    else:
        rep.fail("pin.ironclaw", CONFIG, "IRONCLAW_PIN is readable and names a rev", why)
    md, why = pin_file("MODEL_PIN")
    if md:
        rep.ok("pin.model", CONFIG, f"MODEL_PIN = {md}")
        rep.data["model_pin"] = md
    else:
        rep.fail("pin.model", CONFIG, "MODEL_PIN is readable and names a model", why)


def check_services(rep):
    try:
        import services
    except Exception as e:
        return rep.fail("service.import", CONFIG, "service definitions import", str(e))
    names = services.available(ROOT)
    if not names:
        return rep.fail("service.present", CONFIG, "at least one service definition exists",
                        f"{services.services_dir(ROOT)} holds no *.json")
    bad = []
    loaded = {}
    for n in names:
        try:
            loaded[n] = services.load_service(n, ROOT)
        except Exception as e:
            bad.append(f"{n}: {e}")
    if bad:
        return rep.fail("service.valid", CONFIG, "every service definition validates",
                        "; ".join(bad))
    rep.data["services"] = {n: {"version": d["version"], "audience": d["audience"],
                                "model_policy": d["model_policy"],
                                "capabilities": d["capabilities"]}
                            for n, d in loaded.items()}
    rep.ok("service.valid", CONFIG,
           "every service definition validates (" +
           ", ".join(f"{n}@{d['version']}" for n, d in sorted(loaded.items())) + ")")
    default_ok = loaded.get(services.DEFAULT_SERVICE, {}).get("audience") == "external"
    rep.verdict(default_ok, "service.default", CONFIG,
                f"the default service ({services.DEFAULT_SERVICE}) is the external one",
                "a forgotten SERVICE= key would land a tenant on an internal composition")


def check_model_agreement(rep, clients):
    """Report the serving invariant already enforced by load_clients, defense in depth.

    Canonical registry tenants cannot deliberately override MODEL_PIN. If this check ever sees
    an off-pin ClientConfig, a non-registry caller bypassed the production loader.
    """
    pin, _ = pin_file("MODEL_PIN")
    if not pin or clients is None:
        return
    off = sorted(c.slug for c in clients.values() if c.model != pin)
    rep.verdict(not off, "tenant.model", CONFIG,
                "every tenant runs the pinned model",
                f"off-pin: {', '.join(off)} — canonical serving must refuse this configuration")


def check_instance(rep):
    api = instance_api()
    code, body = http(api + "/api/health")
    if code == 0:
        return rep.blocked("instance.health", LIVE, f"IronClaw instance answers at {api}",
                           "no response — the instance is down, or this box is not the one "
                           "running it (the registry is per-box; so is this check)")
    doc, why = health_doc(body)
    status = doc.get("status") if doc else None
    rep.verdict(code == 200 and status == "healthy", "instance.health", LIVE,
                f"IronClaw instance healthy at {api}",
                f"HTTP {code}; " + (why or f"status={status!r}, not 'healthy' — "
                                           f"{excerpt(body)}"))
    # A revocation route would change the deprovisioning story entirely, so watch for one
    # arriving rather than assuming the recorded answer stays true across a pin bump.
    lcode, _ = http(api + "/auth/logout", method="POST")
    if lcode == 0:
        rep.blocked("instance.revocation_route", LIVE,
                    "session-revocation route status", "instance unreachable")
    elif lcode == 404:
        rep.ok("instance.revocation_route", LIVE,
               "no session-revocation route (expected: env-bearer mode mounts none) — "
               "deprovisioning cannot cut a token; see SECURITY.md")
    else:
        rep.fail("instance.revocation_route", LIVE,
                 "session-revocation route status changed",
                 f"POST /auth/logout answered HTTP {lcode}, not 404. This is GOOD NEWS and a "
                 "docs bug: a revocation path now exists. Re-read the pinned source, then "
                 "update SECURITY.md and deprovision.sh.")


def bare_token(value):
    """Is this string one identifier-shaped token — no space, no punctuation, no newline?

    The weakest of the three value rules, and the only one that is a SHAPE generalisation
    rather than the service's actual vocabulary — see `account_health_leak` for what that
    leaves open. Used only where nothing tighter is available to delegate to."""
    return 0 < len(value) <= 64 and all(ch.isalnum() or ch in "_-" for ch in value)


def ref_shaped(value, reference):
    """Is this the shape `service_guards.new_ref()` emits — its width, its alphabet?

    A correlation ref is fixed-width hex, so it is pinned exactly instead of falling back to
    the general token rule: `mia_sales_token` is a clean bare token and is not a ref. The
    width comes from a freshly minted reference rather than a literal, so a change to
    `new_ref()` carries this with it; the alphabet is hex because `uuid4().hex` is, and one
    sample cannot be expected to contain all sixteen digits."""
    return len(value) == len(reference) and all(ch in "0123456789abcdef" for ch in value)


def account_health_leak(doc):
    """(leaked, why) for one parsed /health body — None when it could not be evaluated.

    DELEGATED, NOT RE-IMPLEMENTED. `deploy/account-intel/data/service_guards.safe_error` IS
    the Account Service's answer to what a caller may learn when the backend fails, so its
    keys are the entire failure vocabulary and `{"ok": true}` is the entire success one.

    What stood here was a keyword denylist — "traceback", "psycopg", "dsn=", "password" — and
    a denylist only ever catches the leak it was told about. A psycopg connection string
    reaches a caller as `host=… port=… user=… dbname=…`; carrying `host=` but not `dsn=`, it
    walked straight through. An allowlist inverts the default: anything the service was not
    designed to say is the finding, including the shape nobody thought of.

    Values are judged as well as keys, because a permitted key can carry a forbidden value —
    the exact failure this guards is `str(e)` landing in `error`. Each key is held to the
    tightest rule its authority supports:

        ok     must be a bool.
        ref    must be the shape `new_ref()` emits (`ref_shaped`) — fixed-width hex.
        error  can only be shape-checked: it must be a bare token.

    Prose on a route that needs no credential is the diagnostic that must not be there, and
    length alone does not find it: `FATAL: password authentication failed for user …` is 54
    characters.

    RESIDUAL GAP, stated rather than left to be derived. A token-shaped `error` value passes:
    `{"ok": false, "error": "mia_sales_token"}` is bare-token clean, and an auth route
    echoing the credential it just rejected is a plausible way to produce one. It survives
    because `safe_error(code=...)` accepts any code and no enumeration of them exists to
    check against — closing it means giving `service_guards` a code vocabulary, not writing
    a code list here. A list here would be the console's own second answer to a question the
    service already owns, which is the thing this function exists NOT to do. `ok` and `ref`
    have no such gap.

    The offending value is NEVER echoed: this detail is read in a ticket, and the operator
    reads the real exception in the process log via `ref`."""
    try:
        guards = account_guards()
    except Exception as e:
        return None, ("cannot ask the Account Service what it is allowed to say: "
                      f"{type(e).__name__}: {e}")
    allowed = {"ok"} | set(guards.safe_error()[0])
    extra = sorted(k for k in doc if k not in allowed)
    if extra:
        return True, ("the health body carries field(s) the service is not allowed to expose: "
                      + ", ".join(map(repr, extra)))
    for key, value in sorted(doc.items()):
        if key == "ok":
            permitted = isinstance(value, bool)
        elif key == "ref":
            permitted = isinstance(value, str) and ref_shaped(value, guards.new_ref())
        else:
            permitted = isinstance(value, str) and bare_token(value)
        if not permitted:
            return True, (f"the health field {key!r} is not a stable code — a raw diagnostic "
                          "reached a route that needs no credential. The value is withheld "
                          "here; read the process log for the exception behind `ref`.")
    return False, ""


def check_account_service(rep):
    base = account_base()
    code, body = http(base + "/health")
    if code == 0:
        return rep.blocked("account.health", LIVE, f"Account Service answers at {base}",
                           "no response — the org-scoped data layer is unreachable from here")
    doc, why = health_doc(body)
    rep.verdict(code == 200 and doc is not None and doc.get("ok") is True,
                "account.health", LIVE, f"Account Service healthy at {base}",
                f"HTTP {code}; " + (why or f"ok={doc.get('ok')!r}, not true — {excerpt(body)}"))
    # The leak this check exists for is on the FAILURE path — `str(e)` on a psycopg error
    # reaching a route that needs no credential — so it is asked of every answered body, not
    # only of a healthy one, which is where it used to stop.
    if doc is None:
        rep.blocked("account.health_redacted", LIVE,
                    "the health response carries no internal diagnostic",
                    f"nothing to inspect: {why}")
    else:
        leaked, leak_why = account_health_leak(doc)
        if leaked is None:
            rep.blocked("account.health_redacted", LIVE,
                        "the health response carries no internal diagnostic", leak_why)
        else:
            rep.verdict(not leaked, "account.health_redacted", LIVE,
                        "the health response carries no internal diagnostic", leak_why)
    rcode, rbody = http(base + "/ready")
    if rcode == 0:
        rep.blocked("account.ready", LIVE, "Account Service is ready to serve records",
                    "the readiness endpoint is unreachable")
        return
    try:
        readiness = json.loads(rbody) if rbody else {}
    except ValueError:
        readiness = {}
    rep.data["account_db"] = readiness
    rep.verdict(rcode == 200 and readiness.get("ok") is True,
                "account.ready", LIVE,
                "Account Service schema and identity source are ready",
                "; ".join(readiness.get("problems") or [f"HTTP {rcode}"]))


def check_containment(rep, clients, live):
    """Is each tenant's member surface still confined? Asked with the tenant's OWN token,
    which is the only bearer that can read its catalog (an operator read returns the
    operator's own — measured, see test_registry_reconciliation.py)."""
    if clients is None:
        return
    if not live:
        return rep.skipped("tenant.confined", LIVE, "member surfaces are confined",
                           "--offline requested")
    try:
        from tool_surface import egress_observed_off, parse_catalog
    except Exception as e:
        return rep.blocked("tenant.confined", LIVE, "member surfaces are confined",
                           f"cannot import the shared catalog reader: {e}")
    api = instance_api()
    unconfined, blocked = [], []
    for slug, c in sorted(clients.items()):
        code, body = http(f"{api}/api/webchat/v2/settings/tools", token=c.ironclaw_token,
                          timeout=15, limit=1 << 20)
        if code != 200 or not body:
            blocked.append(f"{slug} (HTTP {code})")
            continue
        try:
            state = parse_catalog(json.loads(body), slug)
            egress_observed_off(state, slug)
        except SystemExit as e:            # tool_surface fails closed by exiting
            unconfined.append(f"{slug}: {e}")
        except Exception as e:
            blocked.append(f"{slug} ({type(e).__name__})")
    if unconfined:
        rep.fail("tenant.confined", LIVE, "every tenant's member surface is confined",
                 "; ".join(unconfined))
    elif blocked and len(blocked) == len(clients):
        rep.blocked("tenant.confined", LIVE, "every tenant's member surface is confined",
                    "could not read any tenant's catalog: " + ", ".join(blocked))
    elif blocked:
        rep.fail("tenant.confined", LIVE, "every tenant's member surface is confined",
                 "unreadable for: " + ", ".join(blocked) +
                 " — an unreadable surface is not a confined one")
    else:
        rep.ok("tenant.confined", LIVE,
               f"every tenant's member surface is confined ({len(clients)} checked, "
               "egress tools observed disabled)")


def check_thread_compatibility(rep, clients):
    """Would a COLD START refuse? Asked here because nothing else asks it in time.

    THE INCIDENT. 2026-08-27: the laptop bridge had served for 2d 9h and could not restart —
    `multiagency` held a v1-era row whose identity was all NULL ("legacy compatibility identity
    missing") plus live state, which cannot be attributed after the fact, so `_load_threads`
    refuses rather than guesses. Interpreter-independent; the running process survived only
    because it had loaded that state days earlier and never re-read it. A latent outage waiting
    on any reboot, and NOTHING reported it: against that exact store, `doctor` returned 16 pass
    / 2 FAIL with neither failure related, `tenant inspect` 10 pass, `tenants status` 5 pass.

    `identity_mismatches` had exactly two callers: `telegram_bridge` at startup, where it raises
    (too late — the outage has happened), and `tenant reset-thread`, which is the REMEDY. You had
    to already know to run the only thing that would tell you. This is the third caller, in the
    one place that is read before the failure rather than during it.

    Uptime measures the opposite of restartability, which is precisely why this hid.
    """
    if clients is None:
        return
    try:
        import bridge_state
        db = pathlib.Path(_bridge_paths()[0])
    except Exception as e:
        return rep.blocked("tenant.cold_start", CONFIG, "a cold start would load every thread",
                           f"bridge modules did not import: {type(e).__name__}: {e}")
    if not db.exists():
        return rep.skipped("tenant.cold_start", CONFIG, "a cold start would load every thread",
                           f"no bridge store at {db} — no persisted thread can be incompatible")
    try:
        st = bridge_state.BridgeState(str(db), migrate=False)   # READ-ONLY: see _bridge_read
    except Exception as e:
        return rep.blocked("tenant.cold_start", CONFIG, "a cold start would load every thread",
                           f"the bridge state store did not open: {type(e).__name__}: {e}")
    try:
        bound = {slug: c for slug, c in clients.items() if c.telegram_group_id}
        # THE VACUOUS PASS THIS CHECK MUST NOT PRINT. A first draft of this logic reported a
        # confident "cold start would SUCCEED" for a host where the registry and the store
        # shared no group id at all — it compared nothing and called it health. If no tenant is
        # bound there is no cold start to evaluate, and that is BLOCKED, never PASS.
        if not bound:
            return rep.blocked("tenant.cold_start", CONFIG,
                               "a cold start would load every thread",
                               "no tenant has a bound Telegram group — nothing to evaluate")
        refuse, evaluated = [], 0
        for slug, c in sorted(bound.items()):
            row = st.thread_row(c.telegram_group_id)
            if not row:
                continue                     # no persisted thread: loads clean
            evaluated += 1
            mismatches = st.identity_mismatches(row, c)
            if not mismatches:
                continue
            if (mismatches == ["legacy compatibility identity missing"]
                    and not st.thread_has_state(row)):
                continue                     # the loader binds this one; not a refusal
            refuse.append(f"{slug}: {'; '.join(mismatches)}")
    finally:
        st.close()
    if refuse:
        return rep.fail("tenant.cold_start", CONFIG, "a cold start would load every thread",
                        "the bridge would REFUSE to start: " + " | ".join(refuse) +
                        " — it is serving now only because it loaded this state earlier. "
                        "Stop it and run: ./deploy/ironworks tenant reset-thread <slug> "
                        "--confirm <slug>")
    rep.ok("tenant.cold_start", CONFIG,
           f"a cold start would load every thread ({len(bound)} bound tenant(s), "
           f"{evaluated} with a persisted thread)")


def check_sealed_members(rep, clients, live):
    """Would the bridge start? Every tenant's token must be a sealed MEMBER, not the operator.

    THE POINT OF PUTTING IT HERE. `telegram_bridge.main()` runs this check at startup and refuses
    to serve if it fails or cannot be evaluated. Without a `doctor` equivalent, the first real
    run of that control is a restart — quite possibly one taken during an incident, when the last
    thing an operator wants is a new refusal to diagnose. This makes it answerable in advance.

    Delegates to the seam rather than re-implementing the rule, like every other check here: a
    console carrying its own copy of "what counts as a sealed member" would be a second, quieter
    answer to a security question."""
    if clients is None:
        return
    if not live:
        return rep.skipped("tenant.sealed", LIVE, "every tenant is a sealed member, not the operator",
                           "--offline requested")
    try:
        import context_ingress as ing
    except Exception as e:
        return rep.blocked("tenant.sealed", LIVE, "every tenant is a sealed member, not the operator",
                           f"cannot import the seam: {e}")
    try:
        ing.assert_no_member_is_the_operator(clients)
    except ing.OperatorTokenInRegistry as e:
        # The bridge treats BOTH of these as refuse-to-start. The console separates them, because
        # "a tenant holds the operator token" and "the instance is down" need different operators
        # doing different things — and only the first is a security finding.
        unreachable = "cannot reach" in str(e)
        return (rep.blocked if unreachable else rep.fail)(
            "tenant.sealed", LIVE, "every tenant is a sealed member, not the operator",
            rep.scrub(str(e)) + ("  (the bridge would refuse to start)" if not unreachable
                                 else "  (the bridge would refuse to start until this is reachable)"))
    except Exception as e:
        return rep.blocked("tenant.sealed", LIVE, "every tenant is a sealed member, not the operator",
                           f"probe failed: {type(e).__name__}: {e}")
    rep.ok("tenant.sealed", LIVE,
           f"every tenant is a sealed member ({len(clients)} checked, refused on the admin surface)")


def egress_state():
    """The boundary's live state, derived from the running container — never from files.

    A compose overlay on disk proves an intention. `docker inspect` proves a fact. Reading the
    overlay to decide this — which an earlier version of this console did — is how a control
    that was edited but never recreated reports green forever."""
    try:
        import egress_status as es
    except Exception as e:
        return {"state": "BLOCKED", "why": [f"egress_status did not import: {e}"]}
    container = os.environ.get("MT_CONTAINER")
    if not container:
        container, why = _mt_container_name()
        if not container:
            # Not a boundary failure — a boundary we could not locate, which is a different
            # sentence. Naming a container we guessed at would answer the operator's question
            # about the wrong one.
            return {"state": "BLOCKED", "why": [why]}
    st = es.evaluate(container)
    ok_cfg, why_cfg = es.overlay_configured(ROOT)
    st["overlay_configured"] = ok_cfg
    if not ok_cfg and why_cfg:
        st.setdefault("why", []).append(f"overlay does not validate: {why_cfg}")
    return st


def _mt_container_name():
    """(name, why) — the configured MT container name from `fleet.sh`, or None and a reason.

    The repo already has exactly one authority for this (`fleet_mt_container_configured`), and
    it is the CONFIGURED resolver rather than the live one because what runs on this laptop
    says nothing about what runs on a remote target. A second parser here drifted immediately:
    it kept the trailing comment from `container_name: multiclaw  # …` and produced a container
    nothing could inspect.

    NO FALLBACK LITERAL, and the reason is the one `CONTRIBUTING.md` gives for `MODEL_PIN`: a
    default is the one value that can silently outrank the authority it stands in for. This
    returned "multi-ironclaw-1" whenever the subprocess failed. The configured name is
    `multiclaw`, so the guess named a different container — and because that literal is what
    compose's default project-service naming produces, it is a name that plausibly EXISTS on
    another box without being the instance this registry serves. Evaluating that one and
    reporting VERIFIED is the "green against the wrong thing" `check_egress_containment`
    exists to prevent. Even where it merely fails, it fails wrongly: `evaluate()` answers
    BLOCKED "no such container: multi-ironclaw-1", sending the operator after a container
    that vanished instead of after the resolver that did not answer.

    A name we could not establish is not a name. The caller reports BLOCKED, which is what
    that verdict is for, and `fleet_mt_container_configured` treats a missing compose as a
    hard error for the same reason: a provenance check aimed at the wrong container certifies
    nothing.

    `returncode` is honoured too — it was not. That resolver exits non-zero with its reason on
    stderr when the compose file is missing, and the failure used to reach the literal."""
    try:
        p = subprocess.run(
            ["bash", "-c", '. "$1/deploy/lib/fleet.sh"; fleet_mt_container_configured',
             "_", str(ROOT)],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, ("could not ask deploy/lib/fleet.sh for the MT container name: "
                      f"{type(e).__name__}: {e}")
    if p.returncode != 0:
        detail = (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1].strip()
        return None, f"deploy/lib/fleet.sh could not resolve the MT container name: {detail}"
    name = (p.stdout.strip().splitlines() or [""])[-1].strip()
    if not name:
        return None, "deploy/lib/fleet.sh named no MT container"
    return name, ""


def check_egress_containment(rep, live=True):
    """Report the boundary honestly, and make an unproved boundary cost a non-zero exit.

    VERIFIED is the ONLY state that may be described as containment. RUNNING means structurally
    contained but unproved; FAILED means an active tenant is being served without the boundary;
    BLOCKED means nothing was evaluated, which is never a pass."""
    if not live:
        return rep.skipped("egress.network", LIVE,
                           "the runtime sits behind a default-deny egress boundary",
                           "--offline requested")
    st = egress_state()
    rep.data["egress"] = {k: v for k, v in st.items() if k != "stamp"}
    rep.data["egress"]["verified_at"] = (st.get("stamp") or {}).get("at_iso")
    state, why = st["state"], "; ".join(st.get("why") or [])
    if state == "VERIFIED":
        return rep.ok("egress.network", LIVE,
                      "the runtime has no direct public route; egress is restricted to the "
                      f"configured provider path (verified {(st.get('stamp') or {}).get('at_iso')})")
    if state == "BLOCKED":
        return rep.blocked("egress.network", LIVE,
                           "the runtime sits behind a default-deny egress boundary", why)
    if state == "RUNNING":
        return rep.fail("egress.network", LIVE,
                        "the egress boundary is PROVED, not merely present",
                        why + " — structurally contained but unproved. Run "
                              "./deploy/egress/probe-egress.sh <container>")
    return rep.fail("egress.network", LIVE,
                    "the runtime sits behind a default-deny egress boundary",
                    why + " Design and guarantee: SECURITY.md; runbook: deploy/README.md")


def _pid_alive(pid):
    """Is the recorded bridge process still running on THIS host? True / False / None.

    `os.kill(pid, 0)` sends no signal; it asks the kernel whether the pid exists and whether we
    may signal it. Stdlib only, works the same on macOS and Linux, and needs no `ps` parsing, no
    psutil, and nothing from systemd — so the answer is identical on the serve host and on a
    workstation.

    None when there is nothing to check: no pid recorded (an older store, or a bridge that
    stopped cleanly and cleared it — the caller then falls back to judging the heartbeat, which
    is the pre-existing behaviour).

    TWO HONEST LIMITS. A recycled pid could belong to an unrelated process, which would read as
    alive; pids do not recycle within a two-minute heartbeat window in practice, and the failure
    direction is the safe one — this check only ever turns a green into a red. And a pid owned by
    another user raises PermissionError, which proves a process EXISTS, so that counts as alive.
    """
    if pid in (None, "", "None"):
        return None
    try:
        os.kill(int(pid), 0)
    except (ValueError, TypeError):
        return None                  # unparseable — do not invent a verdict
    except ProcessLookupError:
        return False                 # the kernel has no such process: it is gone
    except PermissionError:
        return True                  # exists, owned by someone else
    return True


def _turn_budget():
    return float(os.environ.get("TURN_BUDGET_SECONDS", "180"))


def _bridge_read(want_blocked=False):
    """Open the bridge store once and read what both bridge readers need.

    `doctor` and `bridge status` ask the same five-step question — import the bridge modules,
    resolve the store, open it, snapshot, close. They differ only in what absence MEANS, so
    the steps live here and the verdict stays at the call site: an absent store is
    (db, None, [], None), not an error, because doctor SKIPs a laptop that runs no bridge
    while `bridge status` BLOCKs — you asked about a bridge and nothing was measured."""
    try:
        import bridge_core           # noqa: F401 — imported HERE so its failure is a verdict
        import bridge_state
        db = str(_bridge_paths()[0])
    except Exception as e:
        return None, None, [], f"bridge modules did not import: {type(e).__name__}: {e}"
    if not pathlib.Path(db).exists():
        return db, None, [], None
    try:
        # READ-ONLY, because this is a status path. Opening runs `_check_version`, so with the
        # default this reported nothing and silently MIGRATED the operator's live store —
        # `--offline doctor` included, which promises to measure nothing live. Observed on a real
        # host during a verification run: schema upgraded, backup written beside it, no output.
        st = bridge_state.BridgeState(db, migrate=False)
        snap = st.progress_snapshot()
        blocked = [dict(r) for r in st.blocked_updates()] if want_blocked else []
        st.close()
    except bridge_state.MigrationRequired as e:
        return db, {"needs_migration": e.got}, [], None
    except Exception as e:
        return db, {"unreadable": type(e).__name__}, [], None
    return db, snap, blocked, None


def _bridge_health(snap, budget, alive):
    """Only ever called after `_bridge_read` returned no error, which is what makes this import
    safe: `bridge_core` is imported inside that guard so a broken one becomes BLOCKED rather
    than a traceback out of `doctor`. It survives today only because telegram_bridge happens to
    import bridge_core too — a transitive guard is not a guard."""
    import bridge_core
    return bridge_core.health(snap, time.time(), budget, pid_alive=alive)


def check_bridge(rep):
    """Fold the bridge's forward-progress verdict into the one-screen view, without failing a
    host that legitimately runs no bridge (the laptop does not; the serve VM does)."""
    db, snap, _, err = _bridge_read()
    if err:
        return rep.blocked("bridge.progress", LIVE, "the bridge is making forward progress", err)
    if snap is None:
        return rep.skipped("bridge.progress", LIVE, "the bridge is making forward progress",
                           "no bridge state store on this host — no bridge runs here")
    if snap.get("needs_migration"):
        return rep.blocked("bridge.progress", LIVE, "the bridge is making forward progress",
                           f"the store is schema version {snap['needs_migration']} and needs an "
                           "upgrade. This command will not perform one — start the bridge, which "
                           "migrates and backs up, then re-check.")
    ok, reasons = _bridge_health(snap, _turn_budget(), _pid_alive(snap.get("pid")))
    rep.verdict(ok, "bridge.progress", LIVE, "the bridge is making forward progress",
                "; ".join(reasons))


def check_identity_duplicates(rep):
    """How many live Account-Service credentials each org holds.

    REPORTED ON THE PASS LINE, NOT A GATE — deliberately. Two live tokens for one org is what a
    credential ROTATION looks like mid-flight (`service_guards.duplicate_orgs` says so in its own
    docstring), so a check that FAILED here would go red on every legitimate rotation, and a gate
    people learn to ignore is worse than no gate. Same shape as `revocation.waived`: the fact
    stays in front of the operator without blocking anything.

    It exists because the condition is otherwise INVISIBLE. Fifteen credentials accumulated
    across six orgs, three of them duplicated, and nothing surfaced it until provisioning refused
    to run — the Account Service's own warning goes to a container log nobody reads, and a
    service process that predates the code emitting that warning never emits it at all.

    Counts only. No token value ever enters this report."""
    try:
        import identities as ids
        doc = ids.load()
    except Exception as e:
        return rep.blocked("identities.duplicates", CONFIG,
                           "no org holds more than one Account-Service credential",
                           f"identity state unreadable: {type(e).__name__}: {e}")
    per = ids.org_token_counts(doc)
    dupes = {o: n for o, n in per.items() if n > 1}
    rep.data["identity_credentials"] = {"orgs": len(per), "tokens": len(doc), "duplicates": dupes}
    if dupes:
        detail = ", ".join(f"{o} ({n})" for o, n in dupes.items())
        rep.ok("identities.duplicates", CONFIG,
               f"{len(dupes)} org(s) hold MORE THAN ONE live Account-Service credential — "
               f"{detail}. A mid-rotation state, or authority a re-provision left behind; "
               "provisioning refuses an org in this state until it is reconciled")
    else:
        rep.ok("identities.duplicates", CONFIG,
               f"every org holds exactly one Account-Service credential "
               f"({len(per)} org(s), {len(doc)} token(s))")


def check_residual_authority(rep):
    """Two checks, deliberately, because a residual session has two separate facts about it:
    whether the token still authenticates (measured) and whether that matters (declared).

    Collapsing them means either a gate that stays red until 2027 — which people learn to
    ignore, and an ignored gate is worse than none — or a green one bought by deleting the
    evidence. Neither is acceptable, so the ledger keeps reporting every live session and only
    ACTIVE_RISK ones fail."""
    try:
        import lifecycle as lc
    except Exception as e:
        return rep.blocked("revocation.residual", CONFIG,
                           "no deprovisioned tenant holds residual authority", str(e))
    outstanding, expired = lc.residual_list()
    blocking, waived = lc.residual_split(outstanding)
    rep.data["residual_authority"] = {"blocking": blocking, "waived": waived}

    if blocking:
        soonest = min(e.get("expires_at", "?") for e in blocking.values())
        rep.fail("revocation.residual", CONFIG,
                 f"{len(blocking)} deprovisioned tenant(s) still hold a valid member session",
                 f"{', '.join(sorted(blocking))} — earliest expiry {soonest}. Containment is "
                 "custody plus the global rotation in deploy/README.md; this is not a "
                 "pass until it expires, is revoked, or is explicitly classified.")
    elif outstanding:
        rep.ok("revocation.residual", CONFIG,
               "no ACTIVE_RISK residual authority outstanding")
    else:
        rep.ok("revocation.residual", CONFIG,
               f"no deprovisioned tenant is carrying residual session authority "
               f"({len(expired)} historical entr(ies))")

    # The waived ones are still LIVE TOKENS. Printed on the PASS line, so the fact stays in
    # front of the operator even though it no longer blocks a release.
    if waived:
        detail = "; ".join(
            f"{s} ({e.get('classification')}, valid until {e.get('expires_at')}: "
            f"{e.get('waiver_reason')})" for s, e in sorted(waived.items()))
        rep.ok("revocation.waived", CONFIG,
               f"{len(waived)} residual session(s) STILL AUTHENTICATE but are classified "
               f"non-blocking — {detail}")


# ── tenant view ───────────────────────────────────────────────────────────────────────

_ACCOUNT_STATUS = {}


def account_service_status(base):
    """Is the Account Service behind `base` answering? Asked once per base, per command.

    The catalog needs the tenant's org token as X-Service-Token, which `http` does not send; an
    unauthenticated probe only tells us the service is up, which is what we want here —
    per-tenant record access is checked by `tenant inspect --deep`. That makes the answer a
    property of the BASE, not of the tenant, and every tenant shares one by default: probing
    per tenant is N identical round trips for one fact, on the command whose whole point is
    that its cost stays flat as tenants arrive."""
    if base not in _ACCOUNT_STATUS:
        code, _ = http(f"{base}/list_accounts", timeout=10)
        _ACCOUNT_STATUS[base] = "service-up" if code in (200, 401) else (
            "unreachable" if code == 0 else f"http-{code}")
    return _ACCOUNT_STATUS[base]


AUTH_ACCEPTED, AUTH_REJECTED, AUTH_UNREACHABLE, AUTH_UNDETERMINED = (
    "accepted", "rejected", "unreachable", "undetermined")


def auth_verdict(code):
    """What one status off the bearer probe says about a tenant's member token.

    The probe is `GET /v1/responses/<id-that-does-not-exist>`, and what its codes mean is
    established by `multi/verify/test_session_revocation.py` (source-traced at the pin, then
    measured) and read the same way by `multi/provision/deprovision.sh`:

        401 / 403  the bearer was refused                          -> rejected
        2xx / 404  the bearer was accepted and the id is not real  -> accepted
        0          nothing answered                                -> unreachable

    404 is the ordinary answer, not the edge case: measured 2026-08-26 against the local
    instance at `IRONCLAW_PIN`, all four registered tenants probe 404. Narrowing "accepted"
    to 2xx would take a healthy fleet red.

    Everything else is UNDETERMINED, and that is the fix. This mapped every unlisted code to
    "accepted", so a 500, a 502 from a proxy in front of the instance, or a 429 printed a
    green line for a tenant whose auth was never established — the console asserting a
    guarantee it had not evaluated. A gateway that never reached the auth decision has told
    us nothing about the token, and "we could not check" must not read as "fine".

    The revocation proof reads its own unlisted codes as ACCEPTED, and that is not a
    disagreement: there, ACCEPTED keeps a deprovisioning gate RED, so the unknown falls on
    the safe side. Here the same reading falls on the unsafe one."""
    if code == 0:
        return AUTH_UNREACHABLE
    if code in (401, 403):
        return AUTH_REJECTED
    if 200 <= code < 300 or code == 404:
        return AUTH_ACCEPTED
    return AUTH_UNDETERMINED


def report_auth(rep, cid, claim, row):
    """One tenant's probe -> one verdict, from the single place that knows what a code means.

    Both tenant views ask the same question of the same probe, so they must not answer it two
    ways: `tenants status` PASSing a status that `tenant inspect` BLOCKs is a disagreement an
    operator settles by believing whichever screen is greener."""
    auth, code = row["auth"], row["auth_status"]
    if auth == AUTH_ACCEPTED:
        return rep.ok(cid, LIVE, claim)
    if auth == AUTH_REJECTED:
        return rep.fail(cid, LIVE, claim,
                        f"the instance refused this tenant's member token (HTTP {code}) — it "
                        "cannot be served; re-provision or restore its registry entry")
    if auth == AUTH_UNREACHABLE:
        return rep.blocked(cid, LIVE, claim, "instance unreachable — nothing was measured")
    return rep.blocked(cid, LIVE, claim,
                       f"the instance answered HTTP {code}, which says nothing about the "
                       "token: the request did not reach the auth decision")


def tenant_row(c, state, live, api):
    """One tenant's operator-visible facts. No credential value ever enters this dict."""
    gid = str(c.telegram_group_id or "")
    st = state.get(gid) or {}
    row = {
        "slug": c.slug,
        "name": c.name,
        "service": c.service_id,
        "persona_sha": c.persona_sha,
        "model": c.model,
        "routing": "active" if gid else "unrouted",
        "telegram_group_bound": bool(gid),
        "thread_started": bool(st.get("prev")),
        "accounts_supplied": len(st.get("supplied") or {}),
        "last_turn_at": st.get("last_turn_at"),
        # Accounts this tenant's catalog lists but whose context does not resolve. A store
        # inconsistency the client never sees and the operator otherwise never learns about.
        "catalog_orphans": sorted((st.get("orphans") or {}).keys()),
        "auth": None,
        # The probe's raw status, kept beside the verdict so a BLOCKED line can name what the
        # instance actually answered. No credential is involved in either value.
        "auth_status": None,
        "records": None,
    }
    if live:
        code, _ = http(f"{api}/v1/responses/resp_{'0' * 32}", token=c.ironclaw_token, timeout=10)
        row["auth"], row["auth_status"] = auth_verdict(code), code
        row["records"] = account_service_status(c.account_base)
    return row


def tenant_records(c):
    """(count, error) for one tenant's own book, using that tenant's org token."""
    req = urllib.request.Request(c.account_base + "/list_accounts",
                                 headers={"X-Service-Token": c.account_token,
                                          "User-Agent": "ironworks-console"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read()).get("count"), None
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}"
    except Exception as e:
        return None, type(e).__name__


