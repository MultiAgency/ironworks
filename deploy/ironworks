def cmd_test(args):
    """Delegate to the quality gate. Under `--json`, report its VERDICT as an artifact.

    `--json`'s contract is that stdout carries JSON and nothing else, and this printed
    run-quality's human output straight through it — so `ironworks --json test | jq` was a
    parse error. The gate's own text is the useful thing when a human runs it, so it keeps
    going to stderr in that mode rather than being discarded."""
    r = subprocess.run([sys.executable, str(ROOT / "deploy" / "run-quality.py")], cwd=ROOT,
                       capture_output=args.json, text=True)
    if not args.json:
        return r.returncode
    print(r.stdout or "", file=sys.stderr, end="")
    print(r.stderr or "", file=sys.stderr, end="")
    rep = Report("test")
    tail = [ln for ln in (r.stdout or "").strip().splitlines() if ln.strip()][-1:] or [""]
    rep.data["quality_gate"] = {"exit_code": r.returncode, "summary": tail[0][:200]}
    if r.returncode == EXIT_BLOCKED:
        rep.blocked("gate.quality", CONFIG, "the repository quality gate passes", tail[0][:200])
    else:
        rep.verdict(r.returncode == 0, "gate.quality", CONFIG,
                    "the repository quality gate passes", tail[0][:200])
    return rep.emit(True, "ironworks test")


def bind_known_secrets(rep):
    """Best-effort credential set for a report built OUTSIDE a command's own flow.

    `Report`'s whole design is that redaction happens on one print path, which only works if the
    secrets are BOUND: `scrub()` still applies the shape rules (header lines, query parameters,
    bot-token URLs) with an empty set, but a bare opaque token — a tenant's IRONCLAW_TOKEN in a
    registry error, the operator token in a probe's exception text — is masked only because
    `load_registry` bound it. The top-level handler below constructs its own Report and so binds
    nothing, which would print exactly what this console exists not to print.

    Every step is independently guarded: this runs because something already failed, and the
    registry may be the thing that failed. A partial secret set is worth more than none."""
    tokens = [os.environ.get("TELEGRAM_BOT_TOKEN")]
    clients = None
    try:
        import registry
        tokens += [os.environ.get(k) for k in registry.OPERATOR_TOKEN_VARS]
    except Exception:
        pass
    try:
        import context_ingress as ing
        clients = ing.load_clients()
    except Exception:
        clients = None
    try:
        import redact
        rep.bind_secrets(redact.secrets_of(clients, *tokens))
    except Exception:
        pass


def import_evidence(checks, path, fingerprint):
    """(rows, note) — `checks` with the other environment's answers folded in where THIS one
    could not evaluate. Never mutates `checks`.

    THE PROBLEM THIS SOLVES. `release.promotable` requires repository-hygiene gates that need a
    git checkout AND live legs that need a provisioned instance. The serve host is a file copy;
    CI has no instance. Neither could ever produce a PASS, so the verdict was unreachable
    everywhere and said "this release is not promotable" when it meant "ask the other room".

    FOUR RULES, and each of them is the difference between composing evidence and fabricating it:

      1. SAME TREE OR NOTHING. Both artifacts carry `tree_fingerprint` (deploy/lib/tree_identity),
         a content hash computable with or without git. A mismatch is refused outright — without
         this, CI's green repository gates would happily combine with a boundary proof taken from
         a different commit, producing a promotion decision that was never true of any one tree.
      2. ONLY WHERE THIS RUN WAS BLIND. A row is imported only if the local verdict is BLOCKED or
         SKIPPED. Evidence may fill a gap; it may never overwrite something measured here.
      3. NEVER OVER A LOCAL FAIL. Falls out of rule 2 and is worth stating: a failure found here
         cannot be argued away by an artifact that did not look.
      4. ONLY A PASS IS WORTH IMPORTING. Carrying the other environment's BLOCKED across just
         moves the hole; the row stays BLOCKED locally and the reason stays honest.
    """
    try:
        doc = json.loads(pathlib.Path(path).read_text())
    except (OSError, ValueError) as e:
        return checks, f"evidence unreadable ({type(e).__name__}), so nothing was imported"
    theirs = doc.get("tree_fingerprint")
    if not fingerprint or not theirs:
        return checks, ("one side could not name its tree, so evidence cannot be matched to it "
                        "and nothing was imported")
    if theirs != fingerprint:
        return checks, (f"evidence describes a DIFFERENT tree ({theirs[:12]}… vs {fingerprint[:12]}…) "
                        "— refused; re-run it against this one")
    by_id = {c["id"]: c for c in doc.get("checks", [])}
    rows, taken = [], []
    for c in checks:
        other = by_id.get(c["id"])
        if (c["verdict"] in (BLOCKED, SKIPPED) and other
                and other.get("verdict") == PASS and other.get("kind") == c["kind"]):
            rows.append({**c, "verdict": PASS,
                         "detail": f"supplied by evidence for tree {fingerprint[:12]}…"})
            taken.append(c["id"])
        else:
            rows.append(c)
    if not taken:
        return rows, "evidence names this tree but answered none of the checks that were blind here"
    return rows, f"{len(taken)} check(s) supplied by evidence: {', '.join(sorted(taken)[:4])}"


def promotion_gate(checks, egress_state):
    """(verdict, why_not) — the promotion decision, as a function of the rows and the boundary.

    A SKIPPED gate disqualifies exactly as a FAIL does. `--offline-only` marks EVERY gate SKIPPED,
    and the rule here was once "no FAIL rows", so the artifact certified promotion to an external
    tenant having run not one test. That was worst precisely where it mattered: the serve host is
    the only host where egress is VERIFIED, hence the only host where this verdict can come out
    true at all, and hence the only host where the bug was reachable.

    Extracted from `cmd_release_verify` so it can be driven directly. The test that covered this
    invoked the CLI and asserted FAIL, which it got — from the egress clause, on a laptop where
    egress is never VERIFIED. It was vacuous in exactly the state the defect lived in.

    THREE-VALUED, BECAUSE NO SINGLE ENVIRONMENT CAN SATISFY THIS. Repository-hygiene gates need a
    git checkout, and `/opt/ironworks` is a file copy; the `live.*` legs need a provisioned
    instance, a WEBUI_TOKEN and paid model calls, which CI has none of. So the host cannot answer
    four checks and CI cannot answer six, and a two-valued verdict called both of those "this
    release is NOT promotable" — a claim about the artifact, when the truth was a claim about the
    room it was measured in. That is the failure mode this whole module argues against, sitting
    in its own headline verdict.

    FAIL still means a guarantee was measured and did not hold. BLOCKED means nothing failed and
    the remaining evidence was not obtainable HERE — so promotion is uncertified rather than
    refused, and the reader is told which environment holds the missing half. Neither is
    promotable: `rep.data["promotable"]` stays False for both, so no consumer of the artifact
    changes meaning.
    """
    rows = [c for c in checks if c["id"] != "release.promotable"]
    # THE BOUNDARY IS DELIBERATELY EXEMPT FROM THE BLOCKED TREATMENT BELOW, and a draft that
    # exempted it was wrong in the softest possible direction. An unevaluable egress state
    # (BLOCKED: no docker, no such container) is genuinely unmeasured, so the rule below would
    # make it "uncertified, ask the other environment". There IS no other environment. A gate
    # row like `gate.lib.doc_refs` is a claim about the REPOSITORY, and CI can answer it for
    # any host; containment is a claim about THIS DEPLOYMENT, and no CI run can ever certify a
    # given host's boundary. "Ask elsewhere" would name a room that does not exist.
    #
    # So any non-VERIFIED boundary REFUSES promotion, which is also the conservative default for
    # the one affirmative, high-consequence decision this artifact makes. Caught by CI: the
    # draft passed locally because a laptop with docker up resolves to RUNNING and never reached
    # the branch, and failed on a fresh checkout that has neither stamp nor containers.
    if egress_state != "VERIFIED":
        return FAIL, (f"egress containment is {egress_state}, not VERIFIED — promotion to any "
                      "external tenant is refused until the boundary is proved on the target "
                      "host (SECURITY.md)")
    # PARTITIONED BY KIND, NOT BY VERDICT. A CONFIG row is something this host CAN evaluate, so
    # anything other than PASS — FAIL, SKIPPED (--offline-only), or BLOCKED (a gate whose
    # interpreter or directory was missing, `cannot run: ...`) — means a guarantee this artifact
    # claims was not obtained. A LIVE row is something this host CANNOT evaluate by
    # construction; those are named rather than required, which is the whole design of the
    # artifact. Keying on the verdict alone let a BLOCKED gate through, which is the same defect
    # as the SKIPPED one in a different spelling.
    unmet = [c for c in rows if c["kind"] == CONFIG and c["verdict"] != PASS]
    gates_run = [c for c in rows if c["id"].startswith("gate.") and c["verdict"] == PASS]
    if unmet:
        named = sorted(c["id"] for c in unmet)
        listed = f"{', '.join(named[:4])}{', …' if len(named) > 4 else ''}"
        broke = [c for c in unmet if c["verdict"] == FAIL]
        if broke:
            # Name the reason the reader is actually looking at. "Nothing ran" and "something
            # broke" are different facts and were being reported with one sentence.
            return FAIL, (f"{len(broke)} configuration check(s) FAILED "
                          f"({', '.join(sorted(c['id'] for c in broke)[:4])}) — a measured "
                          "guarantee did not hold")
        if all(c["verdict"] == SKIPPED for c in unmet):
            return BLOCKED, (f"{len(named)} configuration check(s) were not run ({listed}) — "
                             "--offline-only marks every gate SKIPPED, and an unrun gate is not "
                             "a passing one")
        return BLOCKED, (
            f"nothing failed, but {len(named)} check(s) could not be evaluated in this "
            f"environment ({listed}). Promotion is UNCERTIFIED, not refused. No single "
            "environment can answer all of them: repository-hygiene gates need a git checkout "
            "(CI, or the repo itself), and the live legs need a provisioned instance with a "
            "model gateway key (the serve host). Certifying promotion needs the two halves "
            "together.")
    if not gates_run:
        # A discovered gate list that found nothing must not read as "everything passed".
        return BLOCKED, ("no gate suite ran at all — the discovery globs matched nothing, so "
                         "this artifact attests to no executed test")
    return PASS, ""


def _needs_a_git_checkout(cwd, stdout, stderr):
    """Did this gate die because it asked git a question in a tree that has no git?

    DERIVED FROM THE FAILURE, NOT FROM A LIST OF GATE NAMES. A hand-maintained "these four need
    git" list is wrong the moment a fifth gate starts calling `git ls-files`, and wrong in the
    silent direction — the new one reports FAIL on the serve host and nobody connects it to this.

    NOT a search for "fatal: not a git repository". That string never arrives: these gates run
    git with `capture_output=True`, so git's stderr is swallowed into CalledProcessError and the
    only surviving trace is the repr of the argv plus its exit status. Measured on the host.

    BOTH halves are required, which is what keeps this narrow. A gate that genuinely fails its
    assertions still reports FAIL even if it happens to shell out to git, because the second
    check would find a perfectly good repository.
    """
    blob = f"{stdout or ''}\n{stderr or ''}"
    if "'git'" not in blob or "returned non-zero exit status 128" not in blob:
        return False
    return subprocess.run(["git", "rev-parse", "--git-dir"], cwd=cwd,
                          capture_output=True).returncode != 0


def cmd_release_verify(args):
    """The readiness artifact: what ran, what failed, what was blocked, what was NOT attempted.

    Deliberately does NOT run the live proof suite. Those need a provisioned instance and cost
    model calls; conflating "I ran the offline gates" with "the release is proven" is exactly
    the confusion the artifact exists to prevent. What this does is run every gate that can run
    here, and NAME the ones that cannot, so a reader can tell the difference."""
    rep = Report("release verify")
    check_pins(rep)
    check_services(rep)
    clients = load_registry(rep)
    check_model_agreement(rep, clients)
    check_residual_authority(rep)
    check_identity_duplicates(rep)
    check_egress_containment(rep, live=not args.offline)

    # Every suite is invoked as a plain script, never through pytest: the repo's tests are
    # stdlib-only with self-discovering `__main__` runners (CONTRIBUTING § "Tests need no venv
    # and no pytest"), and a readiness artifact that reports FAIL because the operator's
    # interpreter has no pytest is reporting on the wrong thing. The seam suites import
    # siblings by bare name, so they run from inside their own directory.
    #
    # THAT PREMISE IS LOAD-BEARING AND IS NOW ENFORCED, because it was silently false. A suite
    # with no `__main__` block exits 0 having run nothing, and this artifact scores exit 0 as a
    # pass — so on 2026-08-26 four gates here read `[x]` over 45 unexecuted crash-boundary tests
    # (test_bridge_concurrency / _delivery / _operations / _recovery, split out of the delivery
    # monolith without runners). An artifact whose whole purpose is letting a reader tell what
    # RAN from what did not could not tell, about the highest-consequence block in the tree.
    # `multi/seam/test_suite_contract.py` now asserts that every suite has a runner and that it
    # DISCOVERS via globals() rather than a hand-maintained list. It is itself one of the gates
    # discovered below, so this comment's assumption and its guard fail together or not at all.
    # (`ironworks test` -> run-quality.py was never affected: it runs pytest, which collects by
    # name and ran all 187 regardless. The script-invocation paths were the blind ones.)
    # The suites in these directories are DISCOVERED, not enumerated. A readiness artifact
    # whose gate list is hand-maintained computes `release.promotable` from whatever subset
    # someone remembered to add, and the omission is invisible in the artifact — it reads as a
    # clean run. Every directory named here is offline in its entirety, so "all of it" is a
    # rule a new file cannot fall outside of. multi/verify is NOT one of them: it mixes offline
    # suites with ones that need a provisioned instance, so its offline members are named
    # individually below and the rest are declared unrun under `live.*`.
    #
    # `deploy/egress` WAS MISSING FROM THIS TUPLE while being collected by pytest. Its comment in
    # `pyproject.toml` records that `test_connect_proxy.py` — the forty lines the network
    # guarantee rests on, driving the real gateway over real sockets — "was tracked and collected
    # by NOTHING" until it was added to `testpaths`. That fixed `ironworks test`; it did not fix
    # this. So the release readiness artifact, the thing an operator reads to decide whether a
    # build is promotable, computed `release.promotable` without ever running the egress suites.
    # Exactly the hand-maintained-list omission the paragraph above describes, in the list that
    # paragraph is attached to.
    seam = ROOT / "multi" / "seam"
    offline_dirs = ((seam, "seam", "seam suite"),
                    (ROOT / "deploy" / "lib", "lib", "operator library"),
                    (ROOT / "deploy" / "account-intel" / "data", "accountdb", "Account Store"),
                    (ROOT / "deploy" / "egress", "egress", "egress boundary"))
    gates = [
        (f"gate.{tag}.{p.stem[5:]}", ["python3", p.name], f"{label}: {p.stem}", d)
        for d, tag, label in offline_dirs for p in sorted(d.glob("test_*.py"))
    ] + [
        ("gate.routing", ["python3", "multi/verify/test_adversarial_routing.py"],
         "bridge routing (offline)", ROOT),
        ("gate.fixtures", ["python3", "multi/verify/test_fixtures_offline.py"],
         "committed-fixture contract (offline)", ROOT),
        ("gate.freshness", ["python3", "multi/verify/test_freshness_lifecycle.py", "--offline"],
         "identity-bound freshness lifecycle (offline)", ROOT),
        ("gate.graders", ["python3", "multi/eval/test_graders.py"], "eval graders self-test", ROOT),
    ]
    if args.offline_only:
        for cid, _, title, _cwd in gates:
            rep.skipped(cid, CONFIG, title, "--offline-only: gates not run")
    else:
        for cid, cmd, title, cwd in gates:
            try:
                r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=600)
            except FileNotFoundError as e:
                rep.blocked(cid, CONFIG, title, f"cannot run: {e}")
                continue
            except subprocess.TimeoutExpired:
                rep.fail(cid, CONFIG, title, "timed out after 600s")
                continue
            tail = (r.stdout or r.stderr or "").strip().splitlines()[-1:] or [""]
            # A GATE THAT NEEDS GIT, ON A TREE THAT IS NOT A CHECKOUT, IS UNMEASURED — NOT FAILED.
            # `/opt/ironworks` is a file copy (deploy/sync-vm.sh), so `git ls-files` exits 128
            # there and four repository-hygiene gates — doc_refs, documented_guarantees,
            # shadowed_binding, ci_contracts — died with CalledProcessError. They were reported
            # FAIL, which says the guarantee is VIOLATED. It is not; the question could not be
            # asked. This module's own rule is that an unevaluated check is never a pass, and the
            # mirror of it matters just as much: permanent red on the serve host for a non-reason
            # is how an operator learns to skim past red. BLOCKED already means exactly this, and
            # `release.promotable` counts it as "did not pass" either way, so nothing is
            # weakened — the verdict just stops lying about which of the two happened.
            if r.returncode != 0 and _needs_a_git_checkout(cwd, r.stdout, r.stderr):
                rep.blocked(cid, CONFIG, title,
                            f"needs a git checkout; {cwd} is not one (this is a file copy, so "
                            "repository-hygiene gates cannot run here — run them in CI or the repo)")
                continue
            # EXIT 3 IS BLOCKED — the vocabulary CONTRIBUTING.md fixes for every gate here, which
            # this runner was the last place not to honour. A gate that knows it could not
            # evaluate itself had no way to say so: every non-zero code collapsed into FAIL, so
            # the honest verdict `run-quality.py` already computed was flattened by its caller.
            if r.returncode == 3:
                rep.blocked(cid, CONFIG, title, tail[0][:200] or "the gate reported BLOCKED")
                continue
            rep.verdict(r.returncode == 0, cid, CONFIG, title,
                        f"exit {r.returncode}: {tail[0][:200]}")

    # The gates that CANNOT run from here, named rather than silently absent.
    for cid, title, why in [
        ("live.isolation", "two-client isolation + hostile cross-org (multi/verify)",
         "needs a provisioned instance with proof clients and a model gateway key"),
        ("live.egress", "egress-closed outcome probe (multi/verify/test_egress_closed.py)",
         "needs a live confined member; run it after every pin bump per deploy/README.md"),
        ("live.revocation", "session-revocation truth (multi/verify/test_session_revocation.py)",
         "needs WEBUI_TOKEN and the instance; mints and deletes a throwaway member"),
        ("live.freshness", "target-host freshness lifecycle",
         "offline identity-bound lifecycle passed separately; live continuation needs a "
         "provisioned tenant, model runtime, Account Service and Account database"),
        ("live.eval", "answer quality (multi/eval/run_eval.py --runs 2)",
         "needs the eval org provisioned and seeded; costs model calls"),
        ("live.pin", "image provenance (deploy/verify-pin.sh <container>)",
         "needs docker on the box that runs the container"),
    ]:
        rep.blocked(cid, LIVE, title, why)

    # PROMOTION GATE. A release artifact that reports a passing test suite beside an
    # unproved network boundary invites exactly the wrong reading. State it as a decision,
    # not as one row among twenty.
    eg = (rep.data.get("egress") or {}).get("state", "BLOCKED")
    # WHICH TREE THIS ARTIFACT IS ABOUT. Recorded unconditionally, not only when composing:
    # an artifact that cannot say what it measured is not evidence anyone else can use later,
    # and the cost of finding that out should not be paid at the moment someone needs it.
    fingerprint, fp_source = tree_identity.tree_fingerprint(ROOT)
    rep.data["tree_fingerprint"] = fingerprint
    rep.data["tree_fingerprint_source"] = fp_source if fingerprint else None
    if not fingerprint:
        rep.data["tree_fingerprint_why"] = fp_source
    rows = rep.checks
    if args.with_evidence:
        rows, note = import_evidence(rep.checks, args.with_evidence, fingerprint)
        rep.data["evidence"] = {"path": str(args.with_evidence), "result": note}
        print(f"   evidence: {note}")
    promotion, why_not = promotion_gate(rows, eg)
    # A waived TEST_RESIDUAL does not block — but it is named in the artifact either way, so a
    # reader can see exactly what was waived and why rather than inferring it from a green row.
    rep.data["waived_residual"] = sorted((rep.data.get("residual_authority") or {})
                                         .get("waived", {}))
    rep.add("release.promotable", CONFIG, promotion,
            "this release may be promoted to an external tenant",
            "" if promotion == PASS else why_not)
    rep.data["artifact_version"] = 2
    # STAYS BOOLEAN, and stays False for BLOCKED. A consumer asking "may I promote this?" gets the
    # same answer it always did; only the row explains WHICH of the two reasons applies. Widening
    # this field to a tri-state would change the meaning of an existing key under the same
    # artifact_version, which is how a machine reader silently starts treating "uncertified" as
    # "cleared".
    rep.data["promotable"] = promotion == PASS
    rep.data["promotion_verdict"] = promotion
    return rep.emit(args.json, "ironworks release verify")


# ── entry ─────────────────────────────────────────────────────────────────────────────

def main(argv):
    ap = argparse.ArgumentParser(prog="ironworks", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="machine-readable report on stdout")
    ap.add_argument("--offline", action="store_true",
                    help="skip every LIVE check (they report SKIPPED, not PASS)")

    # THE SAME TWO FLAGS, ACCEPTED AFTER THE SUBCOMMAND TOO. They were defined on the parent
    # parser alone, so every form the documentation uses — `tenants status --json`
    # (docs/INCIDENT_RESPONSE.md:109), `release verify --json` (deploy/UPGRADE.md:340),
    # README.md:81, deploy/README.md:9, and `egress-control.sh`'s `exec … egress status "$@"` —
    # was an argparse usage error printing nothing on stdout and exiting 2. That is the same
    # code this console uses for EXIT_FAILED ("a guarantee is broken or a tenant is degraded"),
    # so a script wrapping it read a PARSE ERROR as a degraded tenant, and an incident responder
    # following the runbook got no output at all.
    #
    # `default=argparse.SUPPRESS` is load-bearing: without it a subparser writes its own False
    # over a `--json` given BEFORE the subcommand, breaking the form that used to work.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable report on stdout")
    common.add_argument("--offline", action="store_true", default=argparse.SUPPRESS,
                        help="skip every LIVE check (they report SKIPPED, not PASS)")
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("doctor", help="every check, in one screen", parents=[common])
    sub.add_parser("test", help="run the same complete quality gate used by CI", parents=[common])

    t = sub.add_parser("tenants", help="tenant-wide views")
    tsub = t.add_subparsers(dest="sub")
    tsub.add_parser("status", help="one line per tenant", parents=[common])

    ti = sub.add_parser("tenant", help="one tenant")
    tisub = ti.add_subparsers(dest="sub")
    insp = tisub.add_parser("inspect", help="one tenant, in depth", parents=[common])
    insp.add_argument("slug")
    reset = tisub.add_parser("reset-thread", parents=[common],
                             help="reset one conversation/context row; preserve delivery state")
    reset.add_argument("slug")
    reset.add_argument("--confirm", metavar="SLUG",
                       help="repeat the tenant slug exactly; no interactive prompt")

    br = sub.add_parser("bridge", help="the delivery bridge")
    brsub = br.add_subparsers(dest="sub")
    brsub.add_parser("status", parents=[common],
                     help="forward-progress health (what the watchdog reads)")
    redeliver = brsub.add_parser(
        "redeliver", parents=[common],
        help="explicitly resend one retained DELIVERY_RECONCILE answer")
    redeliver.add_argument("update_id", type=int)
    redeliver.add_argument("--confirm", metavar="UPDATE_ID")

    eg = sub.add_parser("egress", help="the network egress boundary")
    egsub = eg.add_subparsers(dest="sub")
    egsub.add_parser("status", parents=[common],
                     help="is the boundary configured, running, verified, or failing?")

    adb = sub.add_parser("account-db", help="the organization-scoped Account Store")
    adbsub = adb.add_subparsers(dest="sub")
    adbsub.add_parser("migration-status", parents=[common],
                      help="is the live schema at the committed version?")

    sv = sub.add_parser("service", help="service definitions")
    svsub = sv.add_subparsers(dest="sub")
    svsub.add_parser("validate", parents=[common],
                     help="validate the committed service definitions")

    rl = sub.add_parser("release", help="release readiness")
    rlsub = rl.add_subparsers(dest="sub")
    rv = rlsub.add_parser("verify", parents=[common],
                          help="run the gates that can run here; name the ones that cannot")
    rv.add_argument("--offline-only", action="store_true",
                    help="do not run the gate subprocesses; list them as SKIPPED")
    rv.add_argument("--with-evidence", metavar="ARTIFACT.json", default=None,
                    help="a --json artifact from the OTHER environment, for the checks this one "
                         "cannot evaluate; accepted only if it names the same tree")

    args = ap.parse_args(argv)
    if not getattr(args, "offline_only", None):
        args.offline_only = False
    if not getattr(args, "with_evidence", None):
        args.with_evidence = None

    route = {
        ("doctor", None): cmd_doctor,
        ("test", None): cmd_test,
        ("tenants", "status"): cmd_tenants_status,
        ("tenant", "inspect"): cmd_tenant_inspect,
        ("tenant", "reset-thread"): cmd_tenant_reset_thread,
        ("bridge", "status"): cmd_bridge_status,
        ("bridge", "redeliver"): cmd_bridge_redeliver,
        ("egress", "status"): cmd_egress_status,
        ("account-db", "migration-status"): cmd_account_db_migration_status,
        ("service", "validate"): cmd_service_validate,
        ("release", "verify"): cmd_release_verify,
    }
    fn = route.get((args.cmd, getattr(args, "sub", None)))
    if fn is None:
        ap.print_help()
        return EXIT_USAGE
    try:
        return fn(args)
    except Exception as e:
        # THE EXIT CODE IS PART OF THE OUTPUT CONTRACT: 0/2/3/64 and nothing else. An escaping
        # exception exits 1 with a traceback on stderr and, under `--json`, an EMPTY stdout —
        # so a wrapper's `json.loads` fails instead of reading a FAIL row. The reachable case is
        # ordinary: `bridge redeliver` and `tenant reset-thread` open the delivery store in a
        # `try/finally` that closes the handle and re-raises, and `sqlite3.OperationalError:
        # database is locked` is exactly the state (a SIGKILLed bridge holding a stale lock) in
        # which an operator reaches for those two commands.
        rep = Report(f"{args.cmd} {getattr(args, 'sub', '') or ''}".strip())
        bind_known_secrets(rep)
        rep.fail("console.completed", CONFIG, "the command ran to completion",
                 f"{type(e).__name__}: {e}")
        return rep.emit(getattr(args, "json", False), "ironworks")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
