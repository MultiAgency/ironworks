def cmd_tenant_reset_thread(args):
    """Explicitly discard one tenant's incompatible conversation, never its delivery record."""
    rep = Report("tenant reset-thread")
    clients = load_registry(rep)
    if clients is None:
        return rep.emit(args.json, "ironworks tenant reset-thread")
    c = clients.get(args.slug)
    if c is None:
        rep.fail("tenant.exists", CONFIG, f"tenant {args.slug!r} is in the registry",
                 "known: " + (", ".join(sorted(clients)) or "(none)"))
        return rep.emit(args.json, "ironworks tenant reset-thread")
    rep.ok("tenant.exists", CONFIG, f"tenant {args.slug!r} is in the registry")
    gid = str(c.telegram_group_id or "")
    if not gid:
        rep.fail("tenant.routing", CONFIG, "the tenant has a Telegram group to reset",
                 "no TELEGRAM_GROUP_ID is configured")
        return rep.emit(args.json, "ironworks tenant reset-thread")

    try:
        import bridge_state as bs
        db, legacy = _bridge_paths()
        if db.exists():
            st = bs.BridgeState(db)
        else:
            st, _ = bs.migrate_from_json(legacy, db)
    except Exception as e:
        rep.fail("thread.state", CONFIG, "the bridge state store opens",
                 f"{type(e).__name__}: {e}")
        return rep.emit(args.json, "ironworks tenant reset-thread")

    try:
        row = st.thread_row(gid)
        stored = bs.BridgeState.stored_identity(row) if row else None
        intended = c.thread_identity
        mismatches = st.identity_mismatches(row, c) if row else []
        snap = st.progress_snapshot()
        alive = _pid_alive(snap.get("pid"))
        rep.data["thread_reset"] = {
            "slug": c.slug, "gid": gid, "store": str(db),
            "stored_identity": stored, "intended_identity": intended,
            "mismatches": mismatches, "thread_present": bool(row),
            "bridge_pid": snap.get("pid"), "bridge_running": alive,
            "delivery_journal": "preserved"}

        def emit_reset():
            if not args.json:
                info = rep.data["thread_reset"]
                print(f"== ironworks tenant reset-thread {c.slug} ==")
                print(f"  stored identity   {info.get('stored_identity')}")
                print(f"  intended identity {info.get('intended_identity')}")
                print(f"  mismatches        {info.get('mismatches') or 'none'}")
                print("  delivery journal preserved")
                print()
            return rep.emit(args.json, "checks")

        if alive is True:
            rep.fail("bridge.stopped", CONFIG, "the bridge is stopped before thread reset",
                     f"recorded pid {snap.get('pid')} is still running; stop it and wait for exit")
            return emit_reset()
        rep.ok("bridge.stopped", CONFIG, "the bridge is stopped before thread reset")

        if args.confirm != c.slug:
            command = (f"./deploy/ironworks tenant reset-thread {c.slug} "
                       f"--confirm {c.slug}")
            rep.fail("thread.confirmed", CONFIG,
                     "the reset confirmation repeats the tenant slug",
                     f"no state changed; run exactly: {command}")
            return emit_reset()
        rep.ok("thread.confirmed", CONFIG, "the reset confirmation repeats the tenant slug")

        removed = st.reset_thread(gid)
        rep.data["thread_reset"]["removed_rows"] = removed
        rep.data["thread_reset"]["thread_present_after"] = bool(st.thread_row(gid))
        rep.ok("thread.reset", CONFIG,
               f"tenant {c.slug!r} conversation/context state reset; delivery journal preserved")
    finally:
        st.close()

    return emit_reset()


def cmd_bridge_status(args):
    """Is the bridge making FORWARD PROGRESS? Not: is a process alive.

    `systemctl is-active` reads green on a bridge wedged inside a turn, and the watchdog's
    poll-error count reads zero for the same reason — a wedged loop is not polling, so it logs
    no poll errors. This compares the heartbeat against progress and against the in-flight
    deadline, which is the only combination that can tell "busy" from "stuck"."""
    rep = Report("bridge status")
    if args.offline:
        # The contract `--offline` states is "LIVE checks report SKIPPED, not PASS", and it was
        # honoured by `doctor` alone — `--offline bridge status` went on evaluating a LIVE-kind
        # row, which is the shape the flag exists to make impossible. Nothing here is skipped
        # for being slow; it is skipped because the flag says every LIVE verdict on this run is
        # unmeasured, and a report may not contain both kinds of claim.
        rep.skipped("bridge.progress", LIVE, "the bridge is making forward progress",
                    "--offline requested")
        return rep.emit(args.json, "ironworks bridge status")
    db, snap, blocked_rows, err = _bridge_read(want_blocked=True)
    if err:
        rep.fail("bridge.import", CONFIG, "the bridge modules import", err)
        return rep.emit(args.json, "ironworks bridge status")
    if snap is None:
        rep.blocked("bridge.state", LIVE, f"the bridge state store exists ({db})",
                    "no store on this host — the bridge has never run here. This is BLOCKED, "
                    "not healthy: nothing was measured.")
        return rep.emit(args.json, "ironworks bridge status")
    if snap.get("needs_migration"):
        rep.blocked("bridge.state", LIVE, f"the bridge state store is readable ({db})",
                    f"schema version {snap['needs_migration']}, and this command will not "
                    "migrate it — a status check that writes is not a status check. Start the "
                    "bridge to upgrade (it backs up first), then re-run.")
        return rep.emit(args.json, "ironworks bridge status")

    budget = _turn_budget()
    alive = _pid_alive(snap.get("pid"))
    ok, reasons = _bridge_health(snap, budget, alive)
    rep.data["bridge"] = {**{k: v for k, v in snap.items() if k != "counts"},
                          "counts": snap.get("counts", {}),
                          "blocked_updates": blocked_rows,
                          "turn_budget_seconds": budget}
    rep.verdict(ok, "bridge.progress", LIVE, "the bridge is making forward progress",
                "; ".join(reasons))
    if not args.json:
        print("== ironworks bridge status ==")
        for k in ("started_at", "heartbeat_at", "last_poll_ok_at", "last_update_at",
                  "last_outcome", "last_delivered_at", "inflight_update_id", "inflight_gid",
                  "inflight_stage", "inflight_deadline_at", "cursor", "cursor_acked",
                  "last_batch_size"):
            print(f"  {k:<22} {snap.get(k)}")
        print(f"  {'process':<22} "
              + {True: f"pid {snap.get('pid')} RUNNING on this host",
                 False: f"pid {snap.get('pid')} NOT RUNNING — the heartbeat above is a fossil",
                 None: "no pid recorded (stopped cleanly, or a store written by an older bridge)"}[alive])
        print(f"  {'counts':<22} {snap.get('counts')}")
        if blocked_rows:
            print("  updates needing reconciliation:")
            for r in blocked_rows:
                print(f"    update {r['update_id']} tenant {r['gid']} {r['state']} "
                      f"({r['error_code']}) at {r['updated_at']}")
        print()
    return rep.emit(args.json, "checks")


def cmd_bridge_redeliver(args):
    """Explicitly resend a DELIVERY_RECONCILE answer while the bridge is stopped."""
    rep = Report("bridge redeliver")
    if args.confirm != str(args.update_id):
        rep.fail("delivery.confirmed", CONFIG, "confirmation repeats the update id",
                 f"no state changed; use --confirm {args.update_id}")
        return rep.emit(args.json, "ironworks bridge redeliver")
    # `--offline` means "skip every LIVE check (they report SKIPPED, not PASS)". This command's
    # whole purpose is a live Telegram send into a client group, so honouring the flag means
    # REFUSING, not proceeding quietly: `--offline bridge redeliver N --confirm N` used to build
    # a real `_Telegram()` and post a message to a tenant. There is no offline half to run.
    # After the confirmation check, not before: a missing --confirm is a usage mistake and
    # deserves the message that names the fix, whichever flags accompany it.
    if args.offline:
        rep.skipped("delivery.redelivered", LIVE,
                    "the original stored model result was redelivered",
                    "--offline: this command sends a real message to a client group; nothing "
                    "was sent and no state changed. Re-run without --offline.")
        return rep.emit(args.json, "ironworks bridge redeliver")
    try:
        import bridge_core
        import bridge_state
        import context_ingress as ing
        import telegram_bridge as tb
        db = _bridge_paths()[0]
        st = bridge_state.BridgeState(db)
    except Exception as e:
        rep.fail("delivery.state", CONFIG, "the delivery store opens", f"{type(e).__name__}: {e}")
        return rep.emit(args.json, "ironworks bridge redeliver")
    try:
        snap = st.progress_snapshot()
        if _pid_alive(snap.get("pid")) is True:
            rep.fail("bridge.stopped", CONFIG, "the bridge is stopped before redelivery",
                     f"recorded pid {snap.get('pid')} is still running")
            return rep.emit(args.json, "ironworks bridge redeliver")
        row = st.update_row(args.update_id)
        if row is None or row["state"] not in (
                bridge_state.DELIVERY_RETRY, bridge_state.DELIVERY_RECONCILE):
            rep.fail("delivery.eligible", CONFIG,
                     f"update {args.update_id} is DELIVERY_RETRY or DELIVERY_RECONCILE",
                     "only a retained delivery result may be explicitly redelivered")
            return rep.emit(args.json, "ironworks bridge redeliver")
        groups = ing.resolve_account_scopes(tb.load_groups())
        gid = str(row["gid"])
        if gid not in groups:
            rep.fail("delivery.routing", CONFIG, "the retained answer still has tenant routing",
                     f"group {gid} is not in the current registry; restore its tenant entry")
            return rep.emit(args.json, "ironworks bridge redeliver")
        bridge = tb.TelegramBridge(
            groups=groups, threads={}, telegram=tb._Telegram(), turns=tb._Turns(), state=st,
            clock=tb._Clock(), log=lambda line: print(line, file=sys.stderr),
            budget_seconds=ing.TURN_BUDGET_SECONDS)
        outcome = bridge.redeliver_reconciled(args.update_id)
        rep.data["delivery"] = {"update_id": args.update_id, "gid": gid,
                                "response_id": row["response_id"], "outcome": outcome}
        if outcome == bridge_core.OUT_REDELIVERED:
            rep.ok("delivery.redelivered", LIVE,
                   "the original stored model result was redelivered; no model turn ran")
        else:
            rep.fail("delivery.redelivered", LIVE,
                     "the original stored model result was redelivered",
                     "send failed; DELIVERY_RECONCILE and the response id were retained")
    finally:
        st.close()
    return rep.emit(args.json, "ironworks bridge redeliver")


