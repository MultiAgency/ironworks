#!/usr/bin/env python3
"""ironworks — the MultiAgency operator's console.

    ./deploy/ironworks doctor                 everything, in one screen
    ./deploy/ironworks tenants status         one line per tenant
    ./deploy/ironworks tenant inspect <slug>  one tenant, in depth
    ./deploy/ironworks tenant reset-thread <slug>  explicit conversation/context reset
    ./deploy/ironworks bridge status          delivery-loop forward progress
    ./deploy/ironworks bridge redeliver <id>  explicit stored-answer delivery reconciliation
    ./deploy/ironworks egress status          the network boundary: RUNNING/VERIFIED/FAILED
    ./deploy/ironworks account-db migration-status  Account Store schema readiness
    ./deploy/ironworks service validate       the committed service definitions
    ./deploy/ironworks release verify         the readiness artifact for a release
    ./deploy/ironworks test                   the complete local/CI quality gate

WHY A CONSOLE. The operator is IronWorks's primary user, and until now answering "is this
tenant healthy, on which service, on which pins, with valid guidance, actually confined, and
safe to upgrade?" meant reading a registry env, a guidance file, two pin files, a compose file,
`docker ps`, and running three proofs by hand — per tenant. That cost does not fall when a
second tenant arrives; it doubles. This is the command that makes it flat.

WHAT IT IS NOT. It re-implements no security rule. Every judgement here is delegated:

    registry validity, credential-uniqueness, operator-token rejection  context_ingress.load_clients
    guidance validity, slug- and service-binding                        persona.load_guidance
    service definitions                                                 services.load_service
    tool-catalog parsing, what counts as egress                         deploy/lib/tool_surface
    image provenance                                                    deploy/verify-pin.sh
    session revocation truth                                            multi/verify/test_session_revocation.py

If a rule needs changing, it changes there and this console follows. A console that carried its
own copy of "what counts as confined" would be a second, quieter answer to a security question.

OUTPUT CONTRACT
  - Human output by default; `--json` for a machine, on stdout, with nothing else on stdout.
  - Every check is CONFIG (does the configuration say the right thing?) or LIVE (did we ask the
    running system?), and the two are never merged into one word.
  - Verdicts: PASS · FAIL · BLOCKED (could not be evaluated) · SKIPPED (deliberately not run).
  - NO SECRETS, ever — output passes through multi/seam/redact.py before it is printed.

EXIT CODES (stable; scripts may depend on them)
  0   every evaluated check passed
  2   at least one check FAILED — a guarantee is broken or a tenant is degraded
  3   nothing failed, but at least one check was BLOCKED — a guarantee is unevaluated
  64  usage error
A BLOCKED guarantee is deliberately non-zero: "we could not check" must never read as "fine".
"""
import argparse
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "multi" / "seam"))
sys.path.insert(0, str(ROOT / "deploy" / "lib"))

# Imported at module scope, unlike the other seam modules this console reaches for lazily
# inside a check: `pins` reads files and holds no environment, so importing it cannot fail on
# a box where the product is not configured.
import pins  # noqa: E402
# Same reasoning: it reads files, holds no environment, and returns None rather than raising when
# the tree cannot be named — so importing it cannot fail on an unconfigured box either.
import tree_identity  # noqa: E402

EXIT_OK, EXIT_FAILED, EXIT_BLOCKED, EXIT_USAGE = 0, 2, 3, 64

PASS, FAIL, BLOCKED, SKIPPED = "PASS", "FAIL", "BLOCKED", "SKIPPED"
CONFIG, LIVE = "config", "live"

_MARK = {PASS: "x", FAIL: "!", BLOCKED: "~", SKIPPED: "-"}


# ── report ────────────────────────────────────────────────────────────────────────────

class Report:
    """Checks plus their verdicts, in one place, so the exit code is derived and not chosen.

    The redaction set is bound to the report rather than applied at each print site: a call
    site that forgets is the whole failure mode, so there is exactly one print path."""

    def __init__(self, command):
        self.command = command
        self.checks = []
        self.data = {}
        self.secrets = set()
        self._redact = None

    def bind_secrets(self, secrets):
        import redact
        self.secrets |= {s for s in secrets if s}
        self._redact = redact

    def scrub(self, text):
        if self._redact is None:
            import redact
            self._redact = redact
        return self._redact.redact(text, self.secrets)

    def add(self, cid, kind, verdict, title, detail=""):
        self.checks.append({"id": cid, "kind": kind, "verdict": verdict,
                            "title": title, "detail": self.scrub(detail)})
        return verdict

    def ok(self, cid, kind, title, detail=""):
        return self.add(cid, kind, PASS, title, detail)

    def fail(self, cid, kind, title, detail=""):
        return self.add(cid, kind, FAIL, title, detail)

    def blocked(self, cid, kind, title, why):
        return self.add(cid, kind, BLOCKED, title, why)

    def skipped(self, cid, kind, title, why):
        return self.add(cid, kind, SKIPPED, title, why)

    def verdict(self, ok, cid, kind, title, detail=""):
        """`detail` explains a FAILURE, so it is dropped on a pass. Carrying it either way made
        the JSON artifact read as if a passing check had a caveat attached."""
        return self.add(cid, kind, PASS if ok else FAIL, title, "" if ok else detail)

    @property
    def exit_code(self):
        if any(c["verdict"] == FAIL for c in self.checks):
            return EXIT_FAILED
        if any(c["verdict"] == BLOCKED for c in self.checks):
            return EXIT_BLOCKED
        # A REPORT THAT EVALUATED NOTHING IS NOT A PASS. Zero PASS/FAIL/BLOCKED rows beside one
        # or more SKIPPED ones means every claim was declined, and exit 0 is read as a verdict:
        # SECURITY.md documents `bridge status` as "exit 0 is healthy, 2 unhealthy, 3
        # unevaluated", so an all-skipped run exiting 0 says HEALTHY about a bridge nothing
        # looked at. `multi/verify/common.Checks.finish` already holds this doctrine for the
        # proof suites ("`ran == 0` is NOT a pass: a suite that asserted nothing has proven
        # nothing"); a report with any evaluated row is unaffected, so `--offline doctor` — nine
        # passing CONFIG rows beside five skipped LIVE ones — still exits 0.
        if self.checks and all(c["verdict"] == SKIPPED for c in self.checks):
            return EXIT_BLOCKED
        return EXIT_OK

    def scrub_tree(self, node):
        """`scrub`, applied to the half of the artifact that is not a check.

        `add()` redacts every detail on the way in, which covered what an operator reads on
        screen and nothing of what a script consumes: `rep.data` carries upstream response
        bodies and reaches stdout untouched. The contract is that output passes through the
        redactor, not that most of it does — and the moment a check starts surfacing a
        non-2xx body, "most" is the wrong half."""
        if isinstance(node, dict):
            return {k: self.scrub_tree(v) for k, v in node.items()}
        if isinstance(node, list):
            return [self.scrub_tree(v) for v in node]
        return self.scrub(node) if isinstance(node, str) else node

    def emit(self, as_json, title=None):
        if as_json:
            print(json.dumps({"command": self.command, "exit_code": self.exit_code,
                              "checks": self.checks, **self.scrub_tree(self.data)},
                             indent=1, sort_keys=True))
            return self.exit_code
        if title:
            print(f"== {title} ==")
        width = max((len(c["id"]) for c in self.checks), default=0)
        for c in self.checks:
            line = f"  [{_MARK[c['verdict']]}] {c['id']:<{width}}  {c['title']}"
            if c["detail"] and c["verdict"] != PASS:
                line += f"\n        {c['kind'].upper()}: {c['detail']}"
            print(line)
        tally = {v: sum(1 for c in self.checks if c["verdict"] == v)
                 for v in (PASS, FAIL, BLOCKED, SKIPPED)}
        print(f"\n  {tally[PASS]} pass · {tally[FAIL]} FAIL · {tally[BLOCKED]} BLOCKED"
              f" · {tally[SKIPPED]} skipped   -> exit {self.exit_code}")
        if tally[BLOCKED]:
            print("  BLOCKED means a guarantee was NOT evaluated. It is not a pass.")
        return self.exit_code


# ── small helpers ─────────────────────────────────────────────────────────────────────

def pin_file(name):
    """First non-comment token of a repo-root pin file, or (None, why).

    Delegates to the seam's reader (`multi/seam/pins.py`) rather than parsing again: the
    console's job is to report on what the product reads, so reading it a second way could
    make the console green on a pin the seam refuses. The non-raising shape is this console's
    requirement, and `pins.pin_value` exists for it."""
    return pins.pin_value(name, ROOT)


def http(url, timeout=5, token=None, method="GET", limit=4000):
    """(status, body-or-None). Never raises. A body is returned for a non-2xx too.

    THE ERROR BODY IS THE DIAGNOSTIC. Discarding it — which this did — threw away the only
    thing an API says about a 4xx/5xx at exactly the moment an operator needs it, and left
    every caller printing a bare `HTTP 503`. `HTTPError` is itself a readable response, so
    the error path reads it the same way and under the same cap. Callers already gate success
    on the status, so nothing reads a failure body as a pass; what changes is that
    `/ready`'s own `problems` list now reaches the operator instead of being dropped.

    None still means there was no body to read: a transport failure, or a response whose
    body could not be read at all.

    `limit` caps the body because most callers only sniff it for a marker and a health body
    has no business being large. The tool catalog is the exception — ~26KB at the pinned rev —
    and a caller that parses JSON must raise the cap, or the truncation becomes a decode error
    that reads as 'unreadable surface' (which fails closed, but for the wrong reason)."""
    headers = {"User-Agent": "ironworks-console"}
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(url, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read().decode("utf-8", "replace")[:limit]
    except urllib.error.HTTPError as e:
        try:
            return e.code, e.read().decode("utf-8", "replace")[:limit]
        except OSError:
            return e.code, None
    except OSError:
        return 0, None


def excerpt(body, limit=300):
    """A response body reduced to one pasteable line, or "" when there is nothing to show.

    No redaction here on purpose: every detail passes `Report.scrub()` on the way into the
    report, and a second redaction point is how one of them ends up being the stale one."""
    if not body:
        return ""
    text = " ".join(str(body).split())
    return text if len(text) <= limit else text[:limit] + " …(truncated)"


def health_doc(body):
    """(doc, why) — a health body parsed as a JSON object, or None with the reason.

    Substring-matching a health body made the verdict depend on the runtime's JSON
    WHITESPACE: `{"status": "healthy"}` and `{"status":"healthy"}` are the same answer and
    one of them read as unhealthy, so a formatting change upstream would have taken a healthy
    fleet red. Its sibling hack — `'"ok": true' in body.replace('"ok":true', '"ok": true')` —
    was a hand-rolled normaliser standing in for the parse that the `/ready` check in this
    same file was already doing correctly. One idiom now, and it is that one."""
    if not body:
        return None, "no body"
    try:
        doc = json.loads(body)
    except ValueError as e:
        return None, f"body is not JSON ({e}): {excerpt(body, 200)}"
    if not isinstance(doc, dict):
        return None, f"body is JSON but not an object ({type(doc).__name__})"
    return doc, ""


def instance_api():
    return (os.environ.get("IRONCLAW_API") or "http://127.0.0.1:3020").rstrip("/")


def account_base():
    return (os.environ.get("ACCOUNT_BASE") or "http://127.0.0.1:8443").rstrip("/")


def account_guards():
    """The Account Service's pure guards — the authority on what its routes may say.

    APPENDED to `sys.path`, never inserted: that directory also holds a `service.py` and a
    `seed.py`, and putting it in front would let either shadow a module this console imports
    for something else entirely. `service_guards` imports nothing but `uuid`, which is why it
    is reachable from here at all."""
    guards_dir = str(ROOT / "deploy" / "account-intel" / "data")
    if guards_dir not in sys.path:
        sys.path.append(guards_dir)
    import service_guards
    return service_guards


def load_registry(rep):
    """The tenants, or None with the reason already recorded as a FAIL.

    `load_clients` is the authority: it enforces credential uniqueness, rejects the operator
    token, refuses duplicate group ids, and validates every guidance file. Calling it IS the
    configuration check — that is the point of not re-implementing it here."""
    # The seam reads IRONCLAW_API at import and refuses to start without it — correct for the
    # bridge, which must never guess which instance it is serving. The console is a read-only
    # inspector with the same default the compose file publishes, so it supplies one rather
    # than making every operator export a variable before they can look at anything.
    os.environ.setdefault("IRONCLAW_API", instance_api())
    try:
        import context_ingress as ing
        import redact
        import registry
    except Exception as e:      # a broken checkout, a missing MODEL_PIN, a bad PERSONA_ROOT
        rep.fail("registry.import", CONFIG, "the seam imports", f"{type(e).__name__}: {e}")
        return None
    try:
        clients = ing.load_clients()
    except Exception as e:
        rep.fail("registry.load", CONFIG,
                 "the client registry loads (fail-closed validation)", f"{type(e).__name__}: {e}")
        return None
    # `redact.secrets_of` takes the extras for a reason: this box holds credentials no tenant
    # env contains — the bot token and the OPERATOR token the sealed-member proof runs with —
    # and a live probe's exception text goes through `rep.scrub()` on its way to the screen.
    rep.bind_secrets(redact.secrets_of(
        clients, os.environ.get("TELEGRAM_BOT_TOKEN"),
        *(os.environ.get(k) for k in registry.OPERATOR_TOKEN_VARS)))
    rep.ok("registry.load", CONFIG,
           f"the client registry loads ({len(clients)} tenant(s), all validations passed)")
    return clients


def _bridge_paths():
    """Where the bridge keeps its store — asked of the bridge, never re-derived here.

    A second copy of the BRIDGE_STATE_DB/BRIDGE_STATE precedence is a second answer to "where
    is the store?", and the console's answer when it guesses wrong is not an error: it is
    `SKIPPED — no bridge runs here` printed against a live bridge. telegram_bridge resolves
    these at CALL time on purpose (see its docstring), so this calls and never captures."""
    import telegram_bridge as tb
    return tb.state_db_path(), tb.state_json_path()


def bridge_state():
    """Per-group thread state, read from the bridge's transactional store.

    Falls back to the retired JSON file when no store exists yet, so a host that has not run
    the migrated bridge still reports rather than going blank — the console must not imply a
    tenant has never been used just because the storage moved."""
    try:
        db, legacy = _bridge_paths()
    except Exception:
        return {}
    if db.exists():
        try:
            import bridge_state as _bs
            # READ-ONLY. This is the console's per-tenant thread view, reached by `doctor` and
            # `tenant inspect` — and with the default it MIGRATED the operator's live store on
            # every invocation, including `--offline doctor`. The `except Exception: return {}`
            # below is what hid it: a MigrationRequired now lands there and the view is simply
            # empty, which is what "I did not look" should have said all along.
            st = _bs.BridgeState(db, migrate=False)
            out = {r["gid"]: {"prev": r["prev"],
                              "supplied": json.loads(r["supplied"] or "{}"),
                              "ever_supplied": bool(r["ever_supplied"]),
                              "last_turn_at": r["last_turn_at"],
                              "orphans": json.loads(r["orphans"] or "{}")}
                   for r in st.all_thread_rows()}
            st.close()
            return out
        except Exception:
            return {}
    try:
        return json.loads(legacy.read_text())
    except (OSError, ValueError):
        return {}


