[Unit]
# IronClaw is the trusted control plane for one client's agent workspace. The instance name is
# the client slug: rustworks-ironclaw@acme.service reads /etc/rustworks/ironclaw-acme.env and owns
# /var/lib/ironclaw/acme.
#
# The persistent sandbox in IronClaw 1.4.0 is Docker-managed. Each instance talks only to the
# rootless daemon owned by the same client service account. It must never join the host `docker`
# group or use /var/run/docker.sock: either would collapse every client back onto one authority
# boundary.
Description=IronClaw sandboxed runtime for client %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/ironclaw/%i
EnvironmentFile=/etc/rustworks/ironclaw-%i.env
Environment=IRONCLAW_REBORN_PROFILE=hosted-single-tenant-volume-sandboxed
Environment=IRONCLAW_REBORN_HOME=/var/lib/ironclaw/%i
Environment=IRONCLAW_REBORN_WORKSPACE_ROOT=/var/lib/ironclaw/%i/workspace
Environment=IRONCLAW_REBORN_LOG=info
ExecStartPre=/opt/rustworks/deploy/check-ironclaw-instance.sh %i
ExecStart=/opt/ironclaw/bin/ironclaw serve --host 127.0.0.1 --port ${IRONCLAW_PORT}
Restart=always
RestartSec=5
User=ironclaw-%i
Group=ironclaw-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Rootless Docker's account-owned socket lives under /run/user/<uid>. ProtectHome=true hides
# /run/user entirely, so the fail-closed preflight can never see the very socket it is required to
# verify. Read-only keeps the home trees immutable to this unit while leaving the socket reachable.
ProtectHome=read-only
ReadWritePaths=/var/lib/ironclaw/%i

[Install]
WantedBy=multi-user.target
